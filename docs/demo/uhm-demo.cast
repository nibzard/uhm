[36.529154, "o", "\u001b[1mProposed command\u001b[22m\r\n\u001b[4:3m\u001b[1mrm\u001b[22m\u001b[4:0m \u001b[4:3m\u001b[32m-rf\u001b[39m\u001b[4:0m \u001b[32m--\u001b[39m build \u001b[2m&&\u001b[22m echo Build artifacts removed.\r\nExpanded from a local alias.\r\n\u001b[4:3mEffects:\u001b[4:0m \u001b[33mdeletes local data\u001b[39m\r\n\u001b[2mDetected:\u001b[22m rm -rf\r\nShell: /bin/bash\r\nCwd: (not disclosed)\r\n\u001b[33mProceeding because --force was supplied.\u001b[39m\r\n"]
