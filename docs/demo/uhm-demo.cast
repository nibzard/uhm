[30.408268, "o", "\u001b[1mProposed command\u001b[22m\r\r\n\u001b[4:3m\u001b[1mrm\u001b[22m\u001b[4:0m \u001b[4:3m\u001b[32m-rf\u001b[39m\u001b[4:0m \u001b[32m--\u001b[39m build\r\r\nExpanded from a local alias.\r\r\n\u001b[4:3mEffects:\u001b[4:0m \u001b[33mdeletes local data\u001b[39m\r\r\n\u001b[2mDetected:\u001b[22m rm -rf\r\r\n"]
[30.408371, "o", "Shell: /bin/bash\r\r\nCwd: (not disclosed)\r\r\nRun, revise, edit, copy, cancel? [R/v/e/c/q] "]
[31.411644, "o", "q\r\r\nuhm: cancelled by user\r\r\n"]
[31.422135, "o", "\r\n\u001b[1;36mCancelled. Nothing was removed.\u001b[0m\r\n"]
