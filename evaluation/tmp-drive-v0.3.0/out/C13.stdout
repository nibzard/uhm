{"namespace":"uhm","outcome":"not_executed","exit_code":11,"executed":false,"command":"import csv\nfrom decimal import Decimal\nfrom uhm_runtime import resource\n\nsource = resource(\"sales\").read_path\nresult = resource(\"total\").write_path\n\ntotal = Decimal(\"0\")\nwith source.open(\"r\", encoding=\"utf-8-sig\", newline=\"\") as f:\n    reader = csv.DictReader(f)\n    if not reader.fieldnames or \"amount\" not in reader.fieldnames:\n        raise ValueError('CSV header has no \"amount\" column')\n    for row in reader:\n        value = row.get(\"amount\")\n        if value is not None and value.strip():\n            total += Decimal(value.strip())\n\ntext = format(total, \"f\")\nif \".\" in text:\n    text = text.rstrip(\"0\").rstrip(\".\")\nif text in {\"\", \"-0\"}:\n    text = \"0\"\nresult.write_text(text + \"\\n\", encoding=\"utf-8\")\n","message":"program review is required; automation must use --force or --dry-run"}
