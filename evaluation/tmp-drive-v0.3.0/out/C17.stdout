{"namespace":"uhm","outcome":"not_executed","exit_code":11,"executed":false,"command":"import csv\nfrom collections import OrderedDict\nfrom decimal import Decimal, InvalidOperation\nfrom uhm_runtime import resource\n\nsource = resource(\"sales\").read_path\noutput = resource(\"by_region\").write_path\n\ntotals = OrderedDict()\nwith source.open(\"r\", encoding=\"utf-8\", newline=\"\") as infile:\n    reader = csv.DictReader(infile)\n    if reader.fieldnames is None or \"region\" not in reader.fieldnames or \"amount\" not in reader.fieldnames:\n        raise ValueError(\"sales.csv must have header columns named region and amount\")\n    for line_number, row in enumerate(reader, start=2):\n        region = row[\"region\"]\n        try:\n            amount = Decimal(row[\"amount\"])\n        except (InvalidOperation, TypeError) as exc:\n            raise ValueError(f\"invalid amount at CSV line {line_number}: {row['amount']!r}\") from exc\n        totals[region] = totals.get(region, Decimal(\"0\")) + amount\n\nwith output.open(\"w\", encoding=\"utf-8\", newline=\"\") as outfile:\n    writer = csv.writer(outfile)\n    writer.writerow([\"region\", \"amount\"])\n    for region, amount in totals.items():\n        writer.writerow([region, format(amount, \"f\")])\n","message":"program review is required; automation must use --force or --dry-run"}
